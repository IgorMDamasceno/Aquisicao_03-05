const PRICING_SHEET_IGOAL = 'Precificação - Igoal';
const BASE_SHEET_CANDIDATES = ['Base de Dados','Base de Dados - Exemplo','BD - GAM','BD - GAM1'];
const PART_ORDER = ['Quiz','P1','P2'];
const HEADER_MAP = {
  date: 'Data',
  hour: 'Hora',
  channel: 'Canal',
  url: 'URL',
  adunit: 'Bloco de Anúncio',
  impressions: 'Impressões',
  clicks: 'Cliques',
  ctr: 'CTR',
  revenue: 'Receita (USD)',
  ecpm: 'eCPM',
