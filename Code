// ============================================================
// CONFIGURAÇÃO DE PALAVRAS-CHAVE DOS BLOCOS DE ANÚNCIO
// Para alterar a nomenclatura dos blocos, edite as listas abaixo.
// Cada lista contém os termos que identificam aquele tipo de bloco.
// Basta adicionar, remover ou renomear os termos conforme necessário.
// ============================================================
const BLOCK_KEYWORDS = {
  MOB_TOP:          ['mob_top', 'mobile_top'],
  MOB_INTERSTITIAL: ['mob_interstitial', 'mobile_interstitial'],
  MOB_OFFERWALL:    ['mob_offerwall', 'mob_rewarded', 'mobile_offerwall', 'mobile_rewarded'],
  REWARDED_QUIZ:    ['rewarded']
};

// Rótulos exibidos nas tabelas para cada tipo de bloco.
// Se renomear um bloco, altere aqui e as tabelas refletirão automaticamente.
const BLOCK_LABELS = {
  MOB_TOP_P1:          'mob_top (P1)',
  MOB_INTERSTITIAL_P1: 'mob_interstitial (P1)',
  MOB_OFFERWALL_P1:    'mob_offerwall (P1)',
  MOB_OFFERWALL_P2:    'mob_offerwall (P2)',
  MOB_TOP_P2:          'mob_top (P2)',
  REWARDED_QUIZ:       'rewarded (Quiz)'
};

// Verifica se uma string contém alguma das palavras-chave da lista
function matchesKeywords_(str, keywords) {
  return keywords.some(function(kw) { return str.indexOf(kw) !== -1; });
}
